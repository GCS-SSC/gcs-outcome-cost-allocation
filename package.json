{
  "name": "@gcs-ssc/gcs-outcome-cost-allocation",
  "version": "0.1.0",
  "description": "GCS-SSC extension for outcome-by-year agreement cost allocations.",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:e2e": "cd ../.. && bun run scripts/nuxt-artifact-lock.ts -- bun run --cwd extensions/gcs-outcome-cost-allocation scripts/test-e2e-managed.ts tests/e2e/allocation-lifecycle.spec.ts"
  },
  "dependencies": {
    "@gcs-ssc/extensions": "^0.2.0"
  },
  "peerDependencies": {
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@electric-sql/pglite": "0.3.16",
    "@types/pg": "^8.16.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "h3": "1.15.5",
    "jsdom": "^28.1.0",
    "kysely": "^0.28.11",
    "kysely-pglite": "^0.6.1",
    "pg": "^8.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4",
    "zod": "^4.3.6"
  }
}
